<mujoco>

  <compiler assetdir=".."/>

  <default>
    <default class="cube">
      <geom friction=".3" conaffinity="2" condim="3" priority="0"
            solref="0.015 1.0" solimp="0.85 0.85 0.001"/>
    </default>
  </default>

  <asset>
    <texture name="cube" type="cube" fileup="textures/fileup.png"
      fileback="textures/fileback.png" filedown="textures/filedown.png"
      filefront="textures/filefront.png" fileleft="textures/fileleft.png"
      fileright="textures/fileright.png"/>
    <material name="cube" texture="cube"/>
    <texture name="graycube" type="cube" fileup="textures/grayup.png"
      fileback="textures/grayback.png" filedown="textures/graydown.png"
      filefront="textures/grayfront.png" fileleft="textures/grayleft.png"
      fileright="textures/grayright.png"/>
    <material name="graycube" texture="graycube"/>
    <texture name="dexcube" type="2d" file="textures/dex_cube.png"/>
    <material name="dexcube" texture="dexcube"/>
    <!-- Cube slot order [right,left,up,down,front,back] = axes [+X,-X,+Y,-Y,+Z,-Z]
         = [purple, blue, red, cyan, green, black]. Filenames do NOT match the
         physical color layout — do not "fix" by filename. -->
    <texture name="arucocube" type="cube"
      fileright="textures/RIGHT_purple.png" fileleft="textures/LEFT_blue.png"
      fileup="textures/TOP_red.png" filedown="textures/BOTTOM_cyan.png"
      filefront="textures/FRONT_green.png" fileback="textures/BACK_black.png"/>
    <material name="arucocube" texture="arucocube"/>
    <mesh name="cube_mesh" file="meshes/dex_cube.obj" scale="0.027 0.027 0.027"/>
  </asset>

  <worldbody>
    <body name="cube" pos="-0.1404 0.0042 0.52" quat="0.3894 -0.3796 -0.5980 -0.5888" childclass="cube">
      <freejoint name="cube_freejoint"/>
      <!-- Visual is a BOX (not the dex_cube mesh): a type="cube" texture maps by
           face direction and only renders correctly on a box; the dex_cube.obj
           mesh's 2D UVs scramble it. -->
      <geom name="cube_visual" type="box" size=".027 .027 .027" material="arucocube" contype="0" conaffinity="0" density="0" group="2"/>
      <geom name="cube" type="box" size=".027 .027 .027" mass=".120" group="3"/>
      <site name="cube_center" pos="0 0 0" group="4"/>
    </body>
  </worldbody>
</mujoco>
